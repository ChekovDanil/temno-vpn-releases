{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ChekovDanil/temno-vpn-releases/main/updates/schema.json",
  "title": "TEMNO VPN public update catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "channels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "TEMNO VPN" },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "beta", "internal"],
      "properties": {
        "stable": { "$ref": "#/$defs/channel" },
        "beta": { "$ref": "#/$defs/channel" },
        "internal": { "$ref": "#/$defs/channel" }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "android", "macos", "ios"],
      "properties": {
        "windows": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
        "android": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
        "macos": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
        "ios": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "published", "automaticUpdate"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)(?:\\.(0|[1-9][0-9]*))?)?$", "maxLength": 40 },
        "published": { "type": "boolean" },
        "prerelease": { "type": "boolean" },
        "automaticUpdate": { "const": false },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "releasePage": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/tag/" },
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/download/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "type": "boolean" },
        "notarized": { "type": "boolean" },
        "stapled": { "type": "boolean" },
        "buildType": { "enum": ["debug", "release"] },
        "status": { "enum": ["development", "scaffold", "candidate", "test", "ready", "handoff"] },
        "distribution": { "enum": ["github-release", "play-store", "app-store", "testflight", "developer-id"] },
        "storeUrl": { "type": "string", "format": "uri" },
        "localOnly": { "type": "boolean" },
        "physicalDeviceTested": { "type": "boolean" },
        "vpnReady": { "type": "boolean" },
        "minimumSdk": { "type": "integer", "minimum": 1 },
        "targetSdk": { "type": "integer", "minimum": 1 },
        "certificateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/androidVariant" }
        },
        "handoff": { "$ref": "#/$defs/handoff" },
        "installer": { "$ref": "#/$defs/artifact" }
      }
    },
    "androidVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abi", "artifact", "url", "size", "sha256", "signed"],
      "properties": {
        "abi": { "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] },
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/download/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "const": true }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published", "prerelease", "type", "tag", "releasePage", "artifact", "url", "size", "sha256"],
      "properties": {
        "published": { "const": true },
        "prerelease": { "const": true },
        "type": { "const": "source-handoff" },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*-internal$" },
        "releasePage": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/tag/" },
        "artifact": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.zip$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/download/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "url", "size", "sha256", "signed", "status"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/download/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "type": "boolean" },
        "status": { "enum": ["test", "ready"] }
      }
    }
  }
}
