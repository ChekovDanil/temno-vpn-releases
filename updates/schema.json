{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ChekovDanil/temno-vpn-releases/main/updates/schema.json",
  "title": "TEMNO VPN public update catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "channels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "TEMNO VPN" },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "beta", "internal"],
      "properties": {
        "stable": { "$ref": "#/$defs/channel" },
        "beta": { "$ref": "#/$defs/channel" },
        "internal": { "$ref": "#/$defs/channel" }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "android", "macos", "ios"],
      "properties": {
        "windows": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
        "android": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
        "macos": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
        "ios": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "published", "automaticUpdate"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)(?:\\.(0|[1-9][0-9]*))?)?$", "maxLength": 40 },
        "published": { "type": "boolean" },
        "automaticUpdate": { "type": "boolean" },
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/download/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "type": "boolean" },
        "notarized": { "type": "boolean" },
        "stapled": { "type": "boolean" },
        "buildType": { "enum": ["debug", "release"] },
        "status": { "enum": ["development", "scaffold", "candidate", "test", "ready"] },
        "distribution": { "enum": ["github-release", "play-store", "app-store", "testflight", "developer-id"] },
        "storeUrl": { "type": "string", "format": "uri" },
        "localOnly": { "type": "boolean" },
        "installer": { "$ref": "#/$defs/artifact" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "url", "size", "sha256", "signed", "status"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/ChekovDanil/temno-vpn-releases/releases/download/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "type": "boolean" },
        "status": { "enum": ["test", "ready"] }
      }
    }
  }
}
